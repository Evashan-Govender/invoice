# Copy to .env.production on the VM. Do not commit the completed file.
POSTGRES_DB=invoiceai
POSTGRES_USER=invoiceai
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://invoiceai:replace-with-a-long-random-password@postgres:5432/invoiceai
JWT_SECRET_KEY=replace-with-a-random-64-character-secret

# Optional default key. Users can alternatively save their own Gemini key in Settings.
GEMINI_API_KEY=

# Used by FastAPI when a separate API origin is required. The default proxy is same-origin.
CORS_ORIGINS=http://YOUR_VM_PUBLIC_IP

# Required only when using Gmail OAuth. This is not reliable on a raw HTTP IP address;
# use a domain with HTTPS before enabling Gmail integration.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=http://YOUR_VM_PUBLIC_IP
